# eggfriedrice for tmux (>= 3.3)
# generated from lua/eggfriedrice/colors.lua by `make extras`; do not edit by hand
# install: `source-file` it from tmux.conf

set -g @eggfriedrice_bg_dark "#090c13"
set -g @eggfriedrice_bg "#0d111a"
set -g @eggfriedrice_bg_light "#121722"
set -g @eggfriedrice_selection "#2f3b54"
set -g @eggfriedrice_fg_gutter "#46516c"
set -g @eggfriedrice_fg_gutter_ui "#586480"
set -g @eggfriedrice_border "#c9a747"
set -g @eggfriedrice_fg "#d8d3c3"
set -g @eggfriedrice_fg_dark "#a8a396"
set -g @eggfriedrice_fg_bright "#f2eddd"
set -g @eggfriedrice_comment "#8695b7"
set -g @eggfriedrice_yellow "#ffc940"
set -g @eggfriedrice_orange "#fc9a2c"
set -g @eggfriedrice_green "#60e654"
set -g @eggfriedrice_cyan "#78e2d6"
set -g @eggfriedrice_blue "#6cb8ff"
set -g @eggfriedrice_purple "#c084fc"
set -g @eggfriedrice_red "#e06c75"
set -g @eggfriedrice_red_bright "#fb6c7a"
set -g @eggfriedrice_green_bright "#57f749"
set -g @eggfriedrice_yellow_bright "#ffda87"
set -g @eggfriedrice_blue_bright "#88c4ff"
set -g @eggfriedrice_purple_bright "#c996ff"
set -g @eggfriedrice_cyan_bright "#5cf5e6"
set -g @eggfriedrice_search "#564825"
set -g @eggfriedrice_search_selected "#907a41"
set -g @eggfriedrice_scope "#7a642b"
set -g @eggfriedrice_diff_add "#192c17"
set -g @eggfriedrice_diff_change "#302509"
set -g @eggfriedrice_diff_delete "#391d1e"
set -g @eggfriedrice_diff_text "#564825"

set -g status-style "fg=#a8a396,bg=#090c13"
set -g status-left-style "fg=#0d111a,bg=#ffc940,bold"
set -g status-right-style "fg=#8695b7,bg=#090c13"

set -g window-status-style "fg=#8695b7,bg=#090c13"
set -g window-status-current-style "fg=#d8d3c3,bg=#0d111a,bold"
set -g window-status-activity-style "fg=#fc9a2c,bg=#090c13"
set -g window-status-bell-style "fg=#0d111a,bg=#ffc940,bold"

set -g window-style "bg=#090c13"
set -g window-active-style "bg=#0d111a"
set -g pane-border-style "fg=#586480"
set -g pane-active-border-style "fg=#c9a747"

# current-window indicator, for your window-status-current-format: #[fg=#ffc940]

set -g message-style "fg=#d8d3c3,bg=#121722"
set -g message-command-style "fg=#ffc940,bg=#121722"
set -g mode-style "fg=#d8d3c3,bg=#2f3b54"
set -g copy-mode-match-style "fg=#d8d3c3,bg=#564825"
set -g copy-mode-current-match-style "fg=#0d111a,bg=#907a41"

set -g popup-style "fg=#d8d3c3,bg=#090c13"
set -g popup-border-style "fg=#c9a747"

set -g clock-mode-colour "#ffc940"
set -g display-panes-colour "#586480"
set -g display-panes-active-colour "#ffc940"
