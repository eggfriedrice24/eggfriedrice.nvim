# eggfriedrice for tmux (>= 3.3)
# generated from lua/eggfriedrice/colors.lua by `make extras`; do not edit by hand
# install: `source-file` it from tmux.conf

set -g status-style "fg=#a8a396,bg=#090c13"
set -g status-left-style "fg=#0d111a,bg=#ffc940,bold"
set -g status-right-style "fg=#8695b7,bg=#090c13"

set -g window-status-style "fg=#8695b7,bg=#090c13"
set -g window-status-current-style "fg=#d8d3c3,bg=#0d111a,bold"
set -g window-status-activity-style "fg=#fc9a2c,bg=#090c13"
set -g window-status-bell-style "fg=#0d111a,bg=#ffc940,bold"

set -g pane-border-style "fg=#586480"
set -g pane-active-border-style "fg=#c9a747"

set -g message-style "fg=#d8d3c3,bg=#121722"
set -g message-command-style "fg=#ffc940,bg=#121722"
set -g mode-style "fg=#d8d3c3,bg=#2f3b54"
set -g copy-mode-match-style "fg=#d8d3c3,bg=#564825"
set -g copy-mode-current-match-style "fg=#0d111a,bg=#92762f"

set -g popup-style "fg=#d8d3c3,bg=#090c13"
set -g popup-border-style "fg=#c9a747"

set -g clock-mode-colour "#ffc940"
set -g display-panes-colour "#586480"
set -g display-panes-active-colour "#ffc940"
