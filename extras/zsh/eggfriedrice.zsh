# eggfriedrice for zsh (zsh-syntax-highlighting, zsh-autosuggestions)
# generated from lua/eggfriedrice/colors.lua by `make extras`; do not edit by hand
# install: source from .zshrc

# zsh-autosuggestions: ghost text in the comment color
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#8695b7"

# zsh-syntax-highlighting: the `main` highlighter styles
typeset -gA ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[default]="fg=#d8d3c3"
ZSH_HIGHLIGHT_STYLES[arg0]="fg=#d8d3c3"
ZSH_HIGHLIGHT_STYLES[unknown-token]="fg=#e06c75,bold,underline"
ZSH_HIGHLIGHT_STYLES[reserved-word]="fg=#c084fc"
ZSH_HIGHLIGHT_STYLES[history-expansion]="fg=#c084fc"

ZSH_HIGHLIGHT_STYLES[command]="fg=#ffc940"
ZSH_HIGHLIGHT_STYLES[builtin]="fg=#ffc940"
ZSH_HIGHLIGHT_STYLES[function]="fg=#ffc940"
ZSH_HIGHLIGHT_STYLES[alias]="fg=#ffc940"
ZSH_HIGHLIGHT_STYLES[suffix-alias]="fg=#ffc940"
ZSH_HIGHLIGHT_STYLES[global-alias]="fg=#ffc940"
ZSH_HIGHLIGHT_STYLES[precommand]="fg=#ffc940"
ZSH_HIGHLIGHT_STYLES[hashed-command]="fg=#ffc940"

ZSH_HIGHLIGHT_STYLES[path]="fg=#d8d3c3,underline"
ZSH_HIGHLIGHT_STYLES[path_prefix]="fg=#d8d3c3,underline"
ZSH_HIGHLIGHT_STYLES[autodirectory]="fg=#d8d3c3,underline"
ZSH_HIGHLIGHT_STYLES[globbing]="fg=#6cb8ff"

ZSH_HIGHLIGHT_STYLES[single-hyphen-option]="fg=#78e2d6"
ZSH_HIGHLIGHT_STYLES[double-hyphen-option]="fg=#78e2d6"

ZSH_HIGHLIGHT_STYLES[single-quoted-argument]="fg=#60e654"
ZSH_HIGHLIGHT_STYLES[double-quoted-argument]="fg=#60e654"
ZSH_HIGHLIGHT_STYLES[dollar-quoted-argument]="fg=#60e654"
ZSH_HIGHLIGHT_STYLES[rc-quote]="fg=#60e654"
ZSH_HIGHLIGHT_STYLES[dollar-double-quoted-argument]="fg=#e06c75"
ZSH_HIGHLIGHT_STYLES[back-double-quoted-argument]="fg=#78e2d6"
ZSH_HIGHLIGHT_STYLES[back-dollar-quoted-argument]="fg=#78e2d6"
ZSH_HIGHLIGHT_STYLES[back-quoted-argument]="fg=#78e2d6"
ZSH_HIGHLIGHT_STYLES[back-quoted-argument-delimiter]="fg=#78e2d6"
ZSH_HIGHLIGHT_STYLES[command-substitution]="fg=#78e2d6"
ZSH_HIGHLIGHT_STYLES[command-substitution-delimiter]="fg=#78e2d6"
ZSH_HIGHLIGHT_STYLES[process-substitution]="fg=#78e2d6"
ZSH_HIGHLIGHT_STYLES[process-substitution-delimiter]="fg=#78e2d6"

ZSH_HIGHLIGHT_STYLES[assign]="fg=#e06c75"
ZSH_HIGHLIGHT_STYLES[redirection]="fg=#6cb8ff"
ZSH_HIGHLIGHT_STYLES[commandseparator]="fg=#6cb8ff"
ZSH_HIGHLIGHT_STYLES[named-fd]="fg=#6cb8ff"
ZSH_HIGHLIGHT_STYLES[numeric-fd]="fg=#6cb8ff"
ZSH_HIGHLIGHT_STYLES[comment]="fg=#8695b7"
