// eggfriedrice for rofi
// generated from lua/eggfriedrice/colors.lua and typography.lua by `make extras`; do not edit by hand
// install: `@import "/path/to/eggfriedrice.rasi"` in your rasi theme, then use @yellow, the launcher roles (@panel, @accent) or the fonts (@font-ui-sm)

* {
    bg-dark: #090c13;
    bg: #0d111a;
    bg-light: #121722;
    selection: #2f3b54;
    fg-gutter: #46516c;
    fg-gutter-ui: #586480;
    border-accent: #c9a747;
    fg: #d8d3c3;
    fg-dark: #a8a396;
    fg-bright: #f2eddd;
    comment: #8695b7;
    yellow: #ffc940;
    orange: #fc9a2c;
    green: #60e654;
    cyan: #78e2d6;
    blue: #6cb8ff;
    purple: #c084fc;
    red: #e06c75;
    red-bright: #fb6c7a;
    green-bright: #57f749;
    yellow-bright: #ffda87;
    blue-bright: #88c4ff;
    purple-bright: #c996ff;
    cyan-bright: #5cf5e6;
    search: #564825;
    search-selected: #907a41;
    scope: #7a642b;
    diff-add: #192c17;
    diff-change: #302509;
    diff-delete: #391d1e;
    diff-text: #564825;

    // launcher roles
    panel: #0d111ab8;
    panel-edge: #58648066;
    panel-divider: #58648040;
    foreground: #d8d3c3;
    input: #f2eddd;
    muted: #8695b7;
    accent: #ffc940;
    on-accent: #090c13;
    urgent: #e06c75;

    // typography, for `font: @font-ui-sm;`
    font-ui-xs: "Atkinson Hyperlegible Next Medium 9";
    font-ui-sm: "Atkinson Hyperlegible Next Medium 10";
    font-ui-md: "Atkinson Hyperlegible Next Medium 11";
    font-ui-lg: "Atkinson Hyperlegible Next Medium 13";
    font-ui-emphasis: "Atkinson Hyperlegible Next SemiBold 10";
    font-mono: "Cartograph CF 10";
    font-icon: "JetBrainsMono Nerd Font Propo 13";
    font-emoji: "Noto Color Emoji 20";
}
